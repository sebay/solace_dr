#!/usr/bin/env bash

# FQDNs to monitor
DOMAINS=("default-solace-a.local" "default-solace-b.local")
INTERVAL=5   # seconds between checks

# Initialize last known IPs
declare -A LAST_IPS
declare -A CHANGED

for DOMAIN in "${DOMAINS[@]}"; do
  IP=$(dig +short "$DOMAIN" | head -n1)
  if [[ -z "$IP" ]]; then
    echo "Failed to resolve $DOMAIN"
    exit 1
  fi
  LAST_IPS["$DOMAIN"]="$IP"
  CHANGED["$DOMAIN"]=0
done

echo "Monitoring DNS for: ${DOMAINS[*]}"
for DOMAIN in "${DOMAINS[@]}"; do
  echo "$DOMAIN => ${LAST_IPS[$DOMAIN]}"
done

while true; do
  sleep "$INTERVAL"

  for DOMAIN in "${DOMAINS[@]}"; do
    # Skip already changed domains
    [[ "${CHANGED[$DOMAIN]}" -eq 1 ]] && continue

    CURRENT_IP=$(dig +short "$DOMAIN" | head -n1)

    if [[ -z "$CURRENT_IP" ]]; then
      echo "$(date): DNS lookup failed for $DOMAIN"
      continue
    fi

    if [[ "$CURRENT_IP" != "${LAST_IPS[$DOMAIN]}" ]]; then
      echo "$(date): IP changed for $DOMAIN!"
      echo "Old IP: ${LAST_IPS[$DOMAIN]}"
      echo "New IP: $CURRENT_IP"
      CHANGED["$DOMAIN"]=1
    else
      echo "$(date): No change for $DOMAIN ($CURRENT_IP)"
    fi
  done

  # Check if all domains have changed
  ALL_CHANGED=1
  for DOMAIN in "${DOMAINS[@]}"; do
    [[ "${CHANGED[$DOMAIN]}" -eq 0 ]] && ALL_CHANGED=0
  done

  if [[ $ALL_CHANGED -eq 1 ]]; then
    echo "$(date): All domains have updated. Exiting."
    break
  fi
done
